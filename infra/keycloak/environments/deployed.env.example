# Example Keycloak deployment contract. Replace every example value through the
# deployment platform's configuration and secret manager. Load after the base file
# only for static validation; this is not a complete production environment file.
KEYCLOAK_CONFIGURATION_PROFILE=deployed
KEYCLOAK_PUBLIC_URL=https://auth.example.invalid
KEYCLOAK_NETWORK_ALIAS=auth.example.invalid
KEYCLOAK_ADMIN_PASSWORD=example-deployed-keycloak-admin-credential
PORTAL_BFF_CLIENT_SECRET=example-deployed-portal-bff-credential
PORTAL_BFF_ORIGIN=https://portal.example.invalid
PORTAL_BFF_CALLBACK_URI=https://portal.example.invalid/api/auth/callback/portal-bff
PORTAL_BFF_POST_LOGOUT_URI=https://portal.example.invalid/
ADMIN_BFF_CLIENT_SECRET=example-deployed-admin-bff-credential
ADMIN_BFF_ORIGIN=https://admin.example.invalid
ADMIN_BFF_CALLBACK_URI=https://admin.example.invalid/api/auth/callback/admin-bff
ADMIN_BFF_POST_LOGOUT_URI=https://admin.example.invalid/
OIDC_ISSUER_URI=https://auth.example.invalid/realms/smart-business
