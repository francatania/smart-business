# Keycloak integration tests only. Load after infra/.env.example.
POSTGRES_PORT=55432
POSTGRES_ADMIN_PASSWORD=test-postgres-admin
APP_DATABASE_PASSWORD=test-smart-business-app
KEYCLOAK_DATABASE_PASSWORD=test-keycloak-database
KEYCLOAK_PORT=18081
KEYCLOAK_ADMIN_PASSWORD=test-keycloak-admin
KEYCLOAK_CONFIGURATION_PROFILE=test
KEYCLOAK_PUBLIC_URL=http://auth.test.localhost:18081
KEYCLOAK_NETWORK_ALIAS=auth.test.localhost
PORTAL_BFF_CLIENT_SECRET=test-portal-bff-client-secret
PORTAL_BFF_ORIGIN=http://portal.test.localhost:15173
PORTAL_BFF_CALLBACK_URI=http://portal.test.localhost:15173/api/auth/callback/portal-bff
PORTAL_BFF_POST_LOGOUT_URI=http://portal.test.localhost:15173/
ADMIN_BFF_CLIENT_SECRET=test-admin-bff-client-secret
ADMIN_BFF_ORIGIN=http://admin.test.localhost:15174
ADMIN_BFF_CALLBACK_URI=http://admin.test.localhost:15174/api/auth/callback/admin-bff
ADMIN_BFF_POST_LOGOUT_URI=http://admin.test.localhost:15174/
OIDC_ISSUER_URI=http://auth.test.localhost:18081/realms/smart-business
OIDC_AUTHORIZATION_URI=http://auth.test.localhost:18081/realms/smart-business/protocol/openid-connect/auth
OIDC_TOKEN_URI=http://keycloak:18081/realms/smart-business/protocol/openid-connect/token
OIDC_JWK_SET_URI=http://keycloak:18081/realms/smart-business/protocol/openid-connect/certs
OIDC_END_SESSION_URI=http://auth.test.localhost:18081/realms/smart-business/protocol/openid-connect/logout
KEYCLOAK_TEST_CUSTOMER_USERNAME=customer.identity.test
KEYCLOAK_TEST_CUSTOMER_PASSWORD=customer-identity-test-password
KEYCLOAK_TEST_ADMIN_USERNAME=admin.identity.test
KEYCLOAK_TEST_ADMIN_PASSWORD=admin-identity-test-password
POSTGRES_DATA_VOLUME=smart-business-keycloak-test-postgres-data
PLATFORM_NETWORK_NAME=smart-business-keycloak-test-platform
SPRING_PROFILES_ACTIVE=test
# The restart assertion needs a session that outlives one backend boot. The expiry test recreates
# only the backend with 3s/30s limits before authenticating its dedicated browser session.
SMART_BUSINESS_SESSION_IDLE_TIMEOUT=90s
SMART_BUSINESS_SESSION_ABSOLUTE_TIMEOUT=2m
BACKEND_PORT=18080
BACKEND_MANAGEMENT_PORT=18082
PORTAL_PORT=15173
ADMIN_PORT=15174
