{
  "realm": {
    "name": "smart-business",
    "displayName": "Smart Business",
    "defaultLocale": "en",
    "supportedLocales": ["en", "es"],
    "registrationAllowed": false,
    "resetPasswordAllowed": false,
    "rememberMe": false
  },
  "roles": ["platform_admin", "support_agent"],
  "clients": [
    {
      "clientId": "portal-bff",
      "name": "Portal BFF",
      "callbackPath": "/api/auth/callback/portal-bff",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "bearerOnly": false
    },
    {
      "clientId": "admin-bff",
      "name": "Administration BFF",
      "callbackPath": "/api/auth/callback/admin-bff",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "bearerOnly": false
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabledWhenConfigured": true,
      "linkOnly": false,
      "trustEmail": true,
      "storeToken": false,
      "syncMode": "IMPORT",
      "scopes": ["openid", "profile", "email"]
    }
  ],
  "passkeys": {
    "browserFlowAlias": "smart-business-browser",
    "requiredActionAlias": "webauthn-register-passwordless",
    "rpEntityName": "Smart Business",
    "signatureAlgorithms": ["ES256", "RS256"],
    "attestationConveyancePreference": "none",
    "residentKey": "required",
    "userVerificationRequirement": "required",
    "avoidSameAuthenticatorRegistration": true
  },
  "securityEvents": {
    "eventsEnabled": true,
    "eventsExpirationSeconds": 172800,
    "enabledEventTypes": [
      "CLIENT_LOGIN_ERROR",
      "CODE_TO_TOKEN_ERROR",
      "EXECUTE_ACTIONS_ERROR",
      "FEDERATED_IDENTITY_LINK_ERROR",
      "IDENTITY_PROVIDER_FIRST_LOGIN_ERROR",
      "IDENTITY_PROVIDER_POST_LOGIN_ERROR",
      "LOGIN_ERROR",
      "LOGOUT_ERROR",
      "REMOVE_CREDENTIAL_ERROR",
      "REMOVE_FEDERATED_IDENTITY_ERROR",
      "UPDATE_CREDENTIAL_ERROR"
    ],
    "eventListeners": [],
    "adminEventsEnabled": true,
    "adminEventsDetailsEnabled": false
  },
  "eventMetrics": {
    "enabled": true,
    "events": [
      "code_to_token",
      "identity_provider_first_login",
      "identity_provider_login",
      "identity_provider_post_login",
      "identity_provider_response",
      "login",
      "logout",
      "refresh_token",
      "remove_credential",
      "update_credential",
      "user_session_deleted"
    ],
    "tags": ["realm", "clientId", "idp"]
  }
}
