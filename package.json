{
  "name": "smart-business",
  "version": "0.1.0",
  "private": true,
  "description": "Business-agnostic scheduling and customer service-record platform.",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": "10.34.0"
  },
  "scripts": {
    "api:check": "pnpm api:generate && git diff --exit-code -- openapi/smart-business.json frontend/packages/api-client/src/generated",
    "api:client": "pnpm --filter @smart-business/api-client generate",
    "api:contract": "node openapi/export-contract.mjs",
    "api:generate": "pnpm api:contract && pnpm api:client",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @smart-business/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
