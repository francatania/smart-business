{
  "components": {
    "schemas": {
      "CsrfTokenResponse": {
        "properties": {
          "headerName": { "type": "string" },
          "parameterName": { "type": "string" },
          "token": { "type": "string" }
        },
        "type": "object"
      },
      "CurrentActor": {
        "properties": {
          "absoluteExpiresAt": { "format": "date-time", "type": "string" },
          "assuranceLevel": { "minLength": 1, "type": "string" },
          "authenticatedAt": { "format": "date-time", "type": "string" },
          "displayName": { "minLength": 1, "type": "string" },
          "globalRoles": { "items": { "type": "string" }, "type": "array" },
          "id": { "format": "uuid", "type": "string" },
          "organizationAccess": {
            "items": { "$ref": "#/components/schemas/OrganizationAccess" },
            "type": "array"
          },
          "status": { "enum": ["ACTIVE", "DISABLED"], "type": "string" },
          "verifiedEmail": { "type": "string" }
        },
        "required": [
          "absoluteExpiresAt",
          "assuranceLevel",
          "authenticatedAt",
          "displayName",
          "globalRoles",
          "id",
          "organizationAccess",
          "status"
        ],
        "type": "object"
      },
      "OrganizationAccess": {
        "properties": {
          "capabilities": { "items": { "type": "string" }, "type": "array" },
          "organizationId": { "format": "uuid", "type": "string" }
        },
        "required": ["capabilities", "organizationId"],
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "actor": { "$ref": "#/components/schemas/CurrentActor" },
          "authenticated": { "type": "boolean" }
        },
        "required": ["authenticated"],
        "type": "object"
      },
      "SystemInfo": {
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" }
        },
        "required": ["name", "version"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "HTTP contract shared by the Smart Business browser applications.",
    "title": "Smart Business API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/csrf": {
      "get": {
        "operationId": "csrf",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/CsrfTokenResponse" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["csrf-controller"]
      }
    },
    "/auth/login/{surface}": {
      "get": {
        "operationId": "initiateLogin",
        "parameters": [
          {
            "in": "path",
            "name": "surface",
            "required": true,
            "schema": { "enum": ["portal", "admin"], "type": "string" }
          },
          {
            "description": "Allowlisted relative destination after login",
            "in": "query",
            "name": "returnTo",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the selected confidential OIDC client"
          },
          "404": { "description": "Unknown application surface" }
        },
        "summary": "Start the Portal or Administration OIDC login flow",
        "tags": ["auth-login-controller"]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No authenticated OIDC session required provider logout"
          },
          "302": {
            "description": "Redirect to the configured OIDC end-session endpoint"
          },
          "403": { "description": "Missing or invalid CSRF token" }
        },
        "summary": "End the local application session and initiate OIDC logout",
        "tags": ["logout-controller"]
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": { "$ref": "#/components/schemas/SessionResponse" }
              }
            },
            "description": "OK"
          }
        },
        "tags": ["session-controller"]
      }
    },
    "/system/info": {
      "get": {
        "operationId": "systemInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SystemInfo" }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Get public application build information",
        "tags": ["System"]
      }
    }
  },
  "servers": [{ "url": "/api" }]
}
